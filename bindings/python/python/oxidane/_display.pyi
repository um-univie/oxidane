from typing import Sequence, Union
from ._oxidane import PyMolecule, PyMolecule3D

class Reaction:
    reactants: tuple[PyMolecule, ...]
    products: tuple[PyMolecule, ...]
    name: str
    def __init__(self, reactants: Sequence[Union[str, PyMolecule, PyMolecule3D]],
                 products: Sequence[Union[str, PyMolecule, PyMolecule3D]], *, name: str = "Reaction") -> None: ...
    def to_svg(self, *, width: int = 800, height: int = 260) -> str: ...
    def plot(self, *, width: int = 800, height: int = 260) -> None: ...
    def _repr_svg_(self) -> str: ...
