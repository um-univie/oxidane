from os import PathLike
from typing import Iterable, List, Literal, Optional, Sequence, Union, overload

class Smarts:
    def __init__(self, smarts: str) -> None: ...

class PyMolecule:
    def __init__(self, smiles: str, *, check_valence: bool = False) -> None: ...
    def to_smiles(self) -> str: ...
    def canonize_mol(self) -> PyMolecule: ...
    def canonize(self) -> None: ...
    def to_canonical_smiles(self) -> str: ...
    def tautomer_key(self, *, carbon_endpoints: bool = False,
                     ionizable_endpoints: bool = True,
                     charge_reduced: bool = False) -> str: ...
    def canonical_tautomer(self, *, carbon_endpoints: bool = False,
                           ionizable_endpoints: bool = False) -> str: ...
    def contains_smarts(self, smarts: str) -> bool: ...
    def contains(self, query: Union[str, Smarts]) -> bool: ...
    def to_svg(self, *, width: int = 400, height: int = 300) -> str: ...
    def plot(self, *, width: int = 400, height: int = 300) -> None: ...
    def _repr_svg_(self) -> str: ...

class PyMolecule3D:
    def to_smiles(self) -> str: ...
    def canonize_mol(self) -> PyMolecule3D: ...
    def canonize(self) -> None: ...
    def to_canonical_smiles(self) -> str: ...
    def to_graph(self) -> PyMolecule: ...
    def contains_smarts(self, smarts: str) -> bool: ...
    def contains(self, query: Union[str, Smarts]) -> bool: ...
    def to_svg(self, *, width: int = 400, height: int = 300) -> str: ...
    def plot(self, *, width: int = 400, height: int = 300) -> None: ...
    def _repr_svg_(self) -> str: ...

class MolParser:
    def __init__(self) -> None: ...
    def parse_file(self, file_path: Union[str, PathLike[str]]) -> List[PyMolecule3D]: ...

class ReactionSmarts:
    def __init__(self, smarts: str) -> None: ...
    @property
    def smarts(self) -> str: ...
    def apply(self, molecule: PyMolecule) -> List[PyMolecule]: ...
    def apply_to(self, reactants: Sequence[PyMolecule]) -> List[PyMolecule]: ...
    def to_svg(self, *, reactants: Optional[Sequence[PyMolecule]] = None,
               width: int = 800, height: int = 260) -> str: ...
    def plot(self, *, reactants: Optional[Sequence[PyMolecule]] = None,
             width: int = 800, height: int = 260) -> None: ...
    def _repr_svg_(self) -> str: ...

# A missing entry (None, NaN, pandas.NA) gives None; whitespace around a SMILES is ignored.
@overload
def canonical_smiles(smiles: str, *, threads: Optional[int] = None,
                     errors: Literal["keep", "none", "raise"] = "keep",
                     check_valence: bool = False) -> str: ...
@overload
def canonical_smiles(smiles: None, *, threads: Optional[int] = None,
                     errors: Literal["keep", "none", "raise"] = "keep",
                     check_valence: bool = False) -> None: ...
@overload
def canonical_smiles(smiles: Iterable[Optional[str]], *, threads: Optional[int] = None,
                     errors: Literal["keep", "none", "raise"] = "keep",
                     check_valence: bool = False) -> List[Optional[str]]: ...

@overload
def tautomer_key(smiles: str, *, carbon_endpoints: bool = False,
                 ionizable_endpoints: bool = True,
                 charge_reduced: bool = False, threads: Optional[int] = None,
                 errors: Literal["keep", "none", "raise"] = "keep",
                 check_valence: bool = False) -> str: ...
@overload
def tautomer_key(smiles: None, *, carbon_endpoints: bool = False,
                 ionizable_endpoints: bool = True,
                 charge_reduced: bool = False, threads: Optional[int] = None,
                 errors: Literal["keep", "none", "raise"] = "keep",
                 check_valence: bool = False) -> None: ...
@overload
def tautomer_key(smiles: Iterable[Optional[str]], *, carbon_endpoints: bool = False,
                 ionizable_endpoints: bool = True,
                 charge_reduced: bool = False, threads: Optional[int] = None,
                 errors: Literal["keep", "none", "raise"] = "keep",
                 check_valence: bool = False) -> List[Optional[str]]: ...

@overload
def canonical_tautomer(smiles: str, *, carbon_endpoints: bool = False,
                       ionizable_endpoints: bool = False, threads: Optional[int] = None,
                       errors: Literal["keep", "none", "raise"] = "keep",
                       check_valence: bool = False) -> str: ...
@overload
def canonical_tautomer(smiles: None, *, carbon_endpoints: bool = False,
                       ionizable_endpoints: bool = False, threads: Optional[int] = None,
                       errors: Literal["keep", "none", "raise"] = "keep",
                       check_valence: bool = False) -> None: ...
@overload
def canonical_tautomer(smiles: Iterable[Optional[str]], *, carbon_endpoints: bool = False,
                       ionizable_endpoints: bool = False, threads: Optional[int] = None,
                       errors: Literal["keep", "none", "raise"] = "keep",
                       check_valence: bool = False) -> List[Optional[str]]: ...
